+procedure R4OpenTrend(const Client: string; Pump, IsCurrent, Hours: Integer);
+var I,Slot: Integer; G: TM_TrendGroup; Name: string;
+begin
+  if Client='' then Exit;
+  Slot:=-1;
+  for I:=0 to 63 do begin
+    if R4Client[I]=Client then begin Slot:=I; Break; end;
+    if (Slot=-1) and (R4Client[I]='') then Slot:=I;
+  end;
+  if Slot=-1 then begin ShowMessageClient(Client,'Графики','Нет свободного контекста просмотра');Exit;end;
+  if R4Client[Slot]='' then begin R4Client[Slot]:=Client;R4Pump[Slot]:=-1;R4Period[Slot]:=6;end;
+  if (Pump>=1) and (Pump<=4) then begin R4Pump[Slot]:=Pump;R4Amps[Slot]:=IsCurrent;end;
+  if (Hours=1) or (Hours=6) or (Hours=24) then R4Period[Slot]:=Hours;
+  if Pump=-1 then R4Pump[Slot]:=-1;
+  if R4Pump[Slot]=-1 then Name:='UiTrend_'+UiKey(0)
+  else if R4Amps[Slot]=1 then Name:='R4TrendI'+IntToStr(R4Pump[Slot])
+  else Name:='R4TrendF'+IntToStr(R4Pump[Slot]);
+  G:=GetTrendGroupByName(Name);
