program ReviewTest;
{$mode delphi}{$H+}{$codepage utf8}
uses SysUtils,Classes;
type TM_Variable=class
  address,opcservername,computername:string; originalasint:int64; outer,isgoodquality,archiving:boolean;
  decimaloffset:integer;decimalmultiplier,last:double;writes:integer;
  procedure setval(a:double);property Value:double read last write setval;
end;
TLabel=record Text:string; Enabled:boolean;Color:integer;end;
const mkMessage=1;
var items:TStringList; clock:double; checks:integer;
 R3Primed,R3Moving: array[0..2] of Boolean;
 R3LastHB: array[0..2] of Int64;
 R3LastTick,R3Changed: array[0..2] of Double;
@@CONTROLS@@:TLabel;
@@TREND_VARIABLES@@:TM_Variable;
@@STATION_DECL@@
procedure TM_Variable.setval(a:double);begin inc(writes);last:=a;end;
function Now:double;begin result:=clock/86400;end;
function RGB(a,b,c:integer):integer;begin result:=a+b*256+c*65536;end;
procedure AddMessage(t:double;k:integer;const s:string;b1,b2:boolean);begin end;
procedure ShowMessageClient(const a,b,c:string);begin end;
function UiPrefix(i:integer):string;begin result:=ProcessItemPrefix;end;
function UiHost(i:integer):string;begin result:=ProcessOPCHost;end;
function UiServer(i:integer):string;begin result:=ProcessOPCServer;end;
function UiStale(i:integer):integer;begin result:=15;end;
function GetVariableByAddress(const s:string):TM_Variable;
var k:integer;begin k:=items.indexof(s);if k<0 then result:=nil else result:=TM_Variable(items.objects[k]);end;
function tag(const s:string):TM_Variable;begin result:=GetVariableByAddress(ProcessItemPrefix+s);end;
function mk(const s:string):TM_Variable;begin result:=TM_Variable.create;result.address:=ProcessItemPrefix+s;
result.outer:=true;result.isgoodquality:=true;result.decimalmultiplier:=1;result.computername:=ProcessOPCHost;result.opcservername:=ProcessOPCServer;
items.addobject(result.address,result);end;
procedure put(const s:string;v:int64);begin tag(s).originalasint:=v;end;
procedure ck(ok:boolean;const name:string);begin if not ok then begin writeln('FAIL ',name);halt(1);end;inc(checks);end;
@@STATION_LOGIC@@@@READ_WORD@@@@DISPLAY@@
procedure TrendTick;
@@TREND@@
procedure seed;begin items:=TStringList.create;DefaultFormatSettings.DecimalSeparator:='.';
@@SEED@@
end;
var i,j,fb,fields,colour:integer;caption,note,name:string;cmd:TM_Variable;temp:boolean;work,cnt,readback,modegroup:int64;reason:string;
begin seed;
  clock:=100;
put('MapVersion',32);
  put('PlcSchemaVersion',27110);
  put('CurrentExportVersion',27401);
  put('CascadeExportVersion',27402);
put('StationMode',10);
  put('CascadeAction',1);
  put('CascadeTargetPump',4);
  put('CascadeRemainingSeconds',3600);
  put('CascadeSelectedPreset',3600);
put('PressureSource',1);
  put('PressureSourceOK',1);
  put('PressurePV_x100',0);
  put('PressureSP_x100',400);
  put('PressureSP_Command',400);
  put('SpFeedbackVersion',1);
for i:=1 to 4 do begin name:=IntToStr(i);
  put('Vfd'+name+'FreqRaw',230+20*i);
  put('Vfd'+name+'FreqState',2);
  put('Vfd'+name+'NativeState',1);
  end;
put('Vfd1CurrentSnapshotRaw',123);
  put('Vfd2CurrentSnapshotRaw',456);
  put('Vfd3CurrentSnapshotRaw',0);
  put('Vfd4CurrentSnapshotRaw',789);
put('Pump1RunMinutes',0);
  put('Pump2RunMinutes',60);
  put('Pump3RunMinutes',120);
  put('Pump4RunMinutes',74070);
put('PlcAliveCounter',65534);
  R3Update;
  clock:=100.5;
  put('PlcAliveCounter',65535);
  put('CurrentExportHeartbeat',65535);
  put('CascadeExportHeartbeat',65535);
R3Update;
  ck(R3Wait.Text='','first heartbeat');
  clock:=101;
  put('PlcAliveCounter',0);
  put('CurrentExportHeartbeat',0);
  put('CascadeExportHeartbeat',0);
R3Update;
  TrendTick;
  ck(R3Cell02.Text='25.0','F1');
  ck(R3Cell12.Text='27.0','F2');
  ck(R3Cell22.Text='29.0','F3');
  ck(R3Cell32.Text='31.0','F4');
ck(R3Cell03.Text='12.3','I1');
  ck(R3Cell13.Text='45.6','I2');
  ck(R3Cell23.Text='0.0','I3 zero');
  ck(R3Cell33.Text='78.9','I4');
ck(R3Cell05.Text='0.0','hours1');
  ck(R3Cell15.Text='1.0','hours2');
  ck(R3Cell25.Text='2.0','hours3');
  ck(R3Cell35.Text='1234.5','hours4');
ck(pos('4: 3600',R3Wait.Text)>0,'physical pump 4');
  ck(TrendPressurePVBar.Archiving and (TrendPressurePVBar.Value=0),'valid zero PV');
put('Vfd4CurrentSnapshotRaw',65535);
  R3Update;
  ck(R3Cell33.Text='6553.5','valid maximum');
put('Vfd4FreqState',0);
  R3Update;
  ck((R3Cell33.Text='--') and (R3Cell32.Text='--') and (R3Cell35.Text='1234.5') and (R3Cell02.Text='25.0'),'Q4 isolation');
put('Vfd4FreqState',2);
  put('CurrentExportVersion',0);
  R3Update;
  ck((R3Cell03.Text='--') and (R3Cell32.Text='31.0'),'old current export');
put('CurrentExportVersion',27401);
  put('Vfd1FreqRaw',5990);
  R3Update;
  TrendTick;
  ck((R3Cell02.Text='599.0') and TrendVfd1FreqHz.Archiving,'max F');
put('Vfd1FreqRaw',5991);
  R3Update;
  TrendTick;
  ck((R3Cell02.Text='--') and not TrendVfd1FreqHz.Archiving,'bad F');
  put('Vfd1FreqRaw',0);
  put('Vfd1FreqState',1);
  R3Update;
  TrendTick;
  ck((R3Cell02.Text='0.0') and TrendVfd1FreqHz.Archiving,'confirmed stop');
put('Pump4RunMinutes',65535);
  R3Update;
  ck(R3Cell35.Text='1092.2','65535 minutes');
  put('Pump4RunMinutes',65536);
  R3Update;
  ck(R3Cell35.Text='1092.3','65536 minutes');
  put('Pump4RunMinutes',4294967295);
  R3Update;
  ck(R3Cell35.Text='71582788.2','uint32max');
for j:=1 to 4 do begin put('CascadeTargetPump',j);
  put('CascadeRemainingSeconds',1);
  R3Update;
  ck(pos(inttostr(j)+': 1',R3Wait.Text)>0,'physical target');
  end;
put('CascadeAction',2);
  put('CascadeSelectedPreset',1800);
  put('CascadeRemainingSeconds',1800);
  R3Update;
  ck(pos('остановки',R3Wait.Text)>0,'common stop');
put('CascadeRemainingSeconds',0);
  R3Update;
  ck(R3Wait.Text='','completion');
  put('CascadeRemainingSeconds',1801);
  R3Update;
  ck(R3Wait.Text='','invalid remaining');
put('CascadeRemainingSeconds',1);
  put('StationMode',20);
  R3Update;
  ck(R3Wait.Text='','manual');
  put('StationMode',0);
  R3Update;
  ck(R3Wait.Text='','stop');
put('StationMode',10);
  put('CascadeAction',0);
  R3Update;
  ck(R3Wait.Text='','cancel');
  put('CascadeAction',1);
for i:=1 to 16 do begin clock:=101+i;
  put('PlcAliveCounter',i);
  put('CurrentExportHeartbeat',i);
  R3Update;
  end;
ck((R3Wait.Text='') and (R3Cell03.Text='12.3'),'stale cascade only');
clock:=118;
  put('PlcAliveCounter',17);
  put('CascadeExportHeartbeat',1);
  R3Update;
  ck(R3Wait.Text<>'','cascade recovery');
for i:=1 to 16 do begin clock:=118+i;
  put('PlcAliveCounter',17+i);
  put('CascadeExportHeartbeat',1+i);
  R3Update;
  end;
ck((R3Cell03.Text='--') and (R3Cell02.Text='0.0') and (R3Wait.Text<>''),'stale current only');
put('CurrentExportHeartbeat',17);
  R3Update;
  ck(R3Cell03.Text='12.3','current recovery');
put('AlarmLo',1);
  tag('AlarmHi').IsGoodQuality:=False;
  R3Update;
  ck(pos('Есть авария',R3Summary.Text)>0,'partial known alarm');
put('AlarmLo',0);
  R3Update;
  ck(pos('Нет полных',R3Summary.Text)>0,'unknown alarms');
  tag('AlarmHi').IsGoodQuality:=True;
put('Vfd4FaultCode',9);
  R3Update;
  ck(pos('Есть авария',R3Summary.Text)>0,'fourth fault');
  put('Vfd4FaultCode',0);
put('PressureSource',0);
  TrendTick;
  ck((not TrendPressurePVBar.Archiving) and TrendPressureSPBar.Archiving,'invalid source index');
put('PressureSource',4);
  TrendTick;
  ck(TrendPressurePVBar.Archiving,'recovered PV');
put('PlcAliveCounter',2);
  R3Update;
  TrendTick;
  ck((R3Cell35.Text='--') and not TrendPressureSPBar.Archiving,'backward jump');
put('PlcAliveCounter',3);
  R3Update;
  ck(R3Cell35.Text<>'--','new progress');
put('MapVersion',31);
  R3Update;
  ck(R3Cell32.Text='--','old map');
  put('MapVersion',32);
  put('PlcSchemaVersion',1);
  R3Update;
  ck(R3Wait.Text='','wrong schema');
  put('PlcSchemaVersion',27110);
temp:=SpControlGate(true,cmd,work,cnt,readback,modegroup,reason);
  ck(not temp,'initial command inhibited');
clock:=135;
  put('PlcAliveCounter',4);
  temp:=SpControlGate(true,cmd,work,cnt,readback,modegroup,reason);
  ck(temp,'command baseline enabled');
cmd:=tag('PressureSP_Command');
  StationSpAdjust(10,'A','user',1);
  StationSpApply('B','other',2);
  ck(cmd.writes=0,'foreign client');
StationSpAdjust(10,'B','other',2);
  StationSpApply('A','user',1);
  ck((cmd.writes=1) and (cmd.Value=410),'single bounded command');
StationSpApply('A','user',1);
  ck(cmd.writes=1,'no replay');
  SpControlUpdate(0,'','');
  ck(SpControlStage=2,'write success distinct from PLC');
put('PressureSP_Command',410);
  put('PressureSP_x100',410);
  put('PlcAliveCounter',5);
  SpControlUpdate(0,'','');
  ck(SpControlStage=2,'one sample insufficient');
put('PlcAliveCounter',6);
  SpControlUpdate(0,'','');
  ck(SpControlStage=3,'PLC accepted distinct from drive');
put('SpApplyFlags',2);
  put('SpConfirmedDrive',4);
  put('SpConfirmed_x100',410);
SpFeedbackView(True,True,410,6,fb,fields,colour,caption,note);
  ck((fields=7) and (fb=1),'seven words first sample');
SpFeedbackView(True,True,410,6,fb,fields,colour,caption,note);
  ck(fb=1,'same counter does not confirm');
put('PlcAliveCounter',7);
  SpFeedbackView(True,True,410,7,fb,fields,colour,caption,note);
  ck(fb=3,'physical drive four and matching SP');
SpControlUpdate(fb,caption,note);
  ck(SpControlStage=4,'drive confirmation separate');
StationSpAdjust(10,'A','user',1);
  put('PressureSP_x100',420);
  StationSpApply('A','user',1);
  ck(cmd.writes=1,'HMI changed base');
put('PressureSP_Command',420);
  SpControlUpdate(0,'','');
  StationSpAdjust(10,'A','user',1);
  StationSpApply('A','user',1);
  ck(cmd.writes=2,'new deliberate request');
for j:=1 to 22 do begin clock:=135+j;
  put('PlcAliveCounter',6+j);
  SpControlUpdate(0,'','');
  end;
ck((cmd.writes=2) and (SpControlStage=6),'timeout without retry');
put('SpApplyFlags',3);
  StationSpAdjust(10,'A','user',1);
  StationSpApply('A','user',1);
  ck(cmd.writes=2,'flags prevent write');
put('SpApplyFlags',0);
  put('StationMode',90);
  temp:=SpControlGate(true,cmd,work,cnt,readback,modegroup,reason);
  ck(not temp,'mode lock');
put('SpApplyFlags',1);
  put('SpApplyError',7);
  put('SpApplyDetail',3);
  SpFeedbackView(True,True,410,41,fb,fields,colour,caption,note);
  SpFeedbackView(True,True,410,42,fb,fields,colour,caption,note);
  ck(fb=4,'drive failure');
put('SpApplyFlags',3);
  SpFeedbackView(True,True,410,43,fb,fields,colour,caption,note);
  ck(fb=5,'feedback flags contradictory');
put('SpApplyFlags',2);
  put('SpConfirmed_x100',420);
  SpFeedbackView(True,True,410,44,fb,fields,colour,caption,note);
  ck(fb=5,'unrelated echo');
tag('SpApplyDetail').IsGoodQuality:=False;
  SpFeedbackView(True,True,410,45,fb,fields,colour,caption,note);
  ck((fb=0) and (fields=6),'missing single feedback word');
ck(SpPressureValid(10) and SpPressureValid(1190) and not SpPressureValid(11) and not SpPressureValid(0) and not SpPressureValid(1200),'SP interval and step');
put('StationMode',10);
  put('CascadeAdd2Seconds',90);
  put('CascadeAdd3Seconds',70);
  put('CascadeAdd4Seconds',70);
  put('CascadeRemoveSeconds',1800);
clock:=160;
  put('PlcAliveCounter',40);
  put('CascadeExportHeartbeat',40);
  R3Update;
  clock:=161;
  put('PlcAliveCounter',41);
  put('CascadeExportHeartbeat',41);
  R3Update;
clock:=162;
  put('PlcAliveCounter',42);
  put('CascadeExportHeartbeat',42);
  R3Update;
  ck(pos('90 / 70 / 70',R3Delays.Text)>0,'independent equal or decreasing settings');
put('CascadeExportVersion',1);
  R3Update;
  ck(R3Wait.Text='','old cascade marker');
tag('Pump4RunMinutes').IsGoodQuality:=False;
  R3Update;
  ck((R3Cell35.Text='--') and (R3Cell25.Text='2.0'),'bad DWORD quality isolated');
tag('SpApplyDetail').IsGoodQuality:=True;
  put('SpApplyFlags',0);
  put('StationMode',10);
  put('PressureSP_Command',420);
  put('PressureSP_x100',420);
clock:=163;
  put('PlcAliveCounter',43);
  SpControlUpdate(0,'','');
  clock:=164;
  put('PlcAliveCounter',44);
  SpControlUpdate(0,'','');
StationSpAdjust(10,'A','user',1);
  ck(SpDraftActive,'draft in AUTO');
  put('StationMode',20);
  StationSpApply('A','user',1);
ck(tag('PressureSP_Command').writes=2,'physical selector changed before Apply');
put('StationMode',10);
  StationSpAdjust(10,'A','user',1);
  put('StationMode',11);
  StationSpApply('A','user',1);
  ck(tag('PressureSP_Command').writes=3,'same AUTO selector across phases');
writeln('PASS isolated Pascal checks: ',checks);
  end.
