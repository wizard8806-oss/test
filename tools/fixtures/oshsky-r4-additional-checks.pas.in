put('Vfd4FaultCode',12); R3Update; R3Update;
ck((Notices=i+1) and (NoticeGroup=4) and (NoticeKind=mkAlarm) and LastAck,'pump4 code change once');
put('Vfd4FaultCode',0); R3Update;
ck((Notices=i+2) and (NoticeGroup=4) and not LastAck,'observed clear in same pump group');
