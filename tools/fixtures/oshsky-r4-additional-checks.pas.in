put('MapVersion',32);
put('CurrentExportVersion',27401);
put('CascadeExportVersion',27402);
put('LeaderPump',2);
put('PumpRunOutputMask',15);
put('FollowersFrequencyRaw',425);
tag('Pump4RunMinutes').IsGoodQuality:=True;
for i:=1 to 4 do begin
  name:=IntToStr(i);
  put('Vfd'+name+'FreqRaw',5990);
  put('Vfd'+name+'FreqState',2);
  put('Vfd'+name+'NativeState',2);
  put('Vfd'+name+'CurrentSnapshotRaw',65535);
  put('Pump'+name+'RunMinutes',4294967295);
  put('Pump'+name+'AutoMember',1);
end;
for j:=1 to 3 do begin
  clock:=164+j;
  put('PlcAliveCounter',44+j);
  put('CurrentExportHeartbeat',40+j);
  put('CascadeExportHeartbeat',40+j);
  R3Update;
  TrendTick;
end;
