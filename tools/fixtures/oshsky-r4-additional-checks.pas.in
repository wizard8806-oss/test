ck(TrendVfd2CurrentA.Archiving and (TrendVfd2CurrentA.Value=6553.5),'I2 independent archive');
ck((R3Cell22.Text='599.0') and (R3Cell23.Text='6553.5') and (R3Cell25.Text='71582788.2'),'pump 3 maxima');
ck(TrendVfd3FreqHz.Archiving and (TrendVfd3FreqHz.Value=599.0),'F3 independent archive');
ck(TrendVfd3CurrentA.Archiving and (TrendVfd3CurrentA.Value=6553.5),'I3 independent archive');
